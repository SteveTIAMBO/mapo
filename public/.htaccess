# Protéger les fichiers sensibles de provisioning (clé compte de service +
# config). Ils existent réellement donc le rewrite SPA ne les couvre pas.
<FilesMatch "^(mapo-provision-config\.php|mapo-sa-key\.json|mapo-notify-config\.php|mapo-ia-config\.php|mapo-pay-config\.php)$">
  Require all denied
</FilesMatch>

# Défense complémentaire : TOUT fichier de config (…-config.php) reste
# inaccessible en direct — couvre les configs présentes et futures
# (mapo-mail-config.php, carre, tranzak, monitor…). Les gabarits d'exemple
# (…-config.example.php) restent lisibles : ils ne contiennent aucun secret.
<FilesMatch "-config\.php$">
  Require all denied
</FilesMatch>

# REGISTRES SERVEUR (mapo-*.json) — jamais lisibles depuis le web.
#
# Ils contiennent les soldes de crédits, les codes cadeaux, les jetons Carré,
# les abonnements aux notifications et les points d'effort. Ils existent
# réellement sur le disque, donc la réécriture SPA ne les couvre pas : sans
# cette règle, ils s'ouvraient en clair dans un navigateur (mesuré le 16/08 :
# HTTP 200, application/json, avec un code cadeau de 2 000 000 de jetons
# lisible tel quel).
#
# ⚠️ La règle DOIT vivre ici, dans le dépôt. Corrigée une première fois
# directement sur le serveur, elle a été écrasée au déploiement suivant — la
# faille était revenue sans que rien ne le signale. Un test de fumée la
# vérifie désormais après chaque mise en ligne.
<FilesMatch "^mapo-.*\.json$">
  Require all denied
</FilesMatch>

# Toujours revalider l'entrée de l'app et le service worker pour éviter
# qu'une mise à jour reste bloquée par le cache navigateur. Les fichiers
# /assets/* sont hashés → ils gardent le cache long par défaut.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ⚠️ Ne PAS tenter de redirection par hôte ici. Essayé le 2026-08-03 : la règle
  # ne se déclenche jamais, Apache ne voit pas le sous-domaine attendu dans
  # %{HTTP_HOST} (front applicatif devant LWS). Et ce fichier est partagé par
  # mapo, mapoplus, adminmapo et TOUS les sous-domaines écoles — une erreur ici
  # les coupe tous d'un coup. Pour retirer un hôte, le supprimer dans cPanel
  # (Domaines → Gérer → Remove Domain) : cPanel garantit alors explicitement de
  # NE PAS toucher au répertoire, ce qui est vital ici puisqu'ils le partagent.

  # Lien magique famille partagé sur WhatsApp : /inviter?c=CODE est servi par
  # un PHP qui porte les balises d'aperçu MAPO+ (un robot de messagerie n'exécute
  # pas le JavaScript, il ne verrait sinon que celles de l'ERP MAPO), puis
  # redirige vers la vraie page /rejoindre de l'application.
  RewriteRule ^inviter/?$ /mapo-invite.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
