# Protéger les fichiers sensibles de provisioning (clé compte de service +
# config). Ils existent réellement donc le rewrite SPA ne les couvre pas.
<FilesMatch "^(mapo-provision-config\.php|mapo-sa-key\.json|mapo-notify-config\.php|mapo-ia-config\.php|mapo-pay-config\.php)$">
  Require all denied
</FilesMatch>

# Défense complémentaire : TOUT fichier de config (…-config.php) reste
# inaccessible en direct — couvre les configs présentes et futures
# (mapo-mail-config.php, carre, tranzak, monitor…). Les gabarits d'exemple
# (…-config.example.php) restent lisibles : ils ne contiennent aucun secret.
<FilesMatch "-config\.php$">
  Require all denied
</FilesMatch>

# Toujours revalider l'entrée de l'app et le service worker pour éviter
# qu'une mise à jour reste bloquée par le cache navigateur. Les fichiers
# /assets/* sont hashés → ils gardent le cache long par défaut.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # miapo.app-edufrem.com est RETIRÉ au profit de mapoplus.app-edufrem.com
  # (2026-08-03). Redirection permanente plutôt que suppression du sous-domaine :
  # les liens magiques famille déjà partagés sur WhatsApp pointent dessus
  # (/rejoindre?c=…) et continuent de fonctionner, chemin et query préservés.
  # Le sous-domaine doit donc RESTER pointé sur ce docroot.
  #
  # ⚠️ VÉRIFIÉ EN PROD LE 03/08 : cette règle NE SE DÉCLENCHE PAS. Les deux hôtes
  # partagent ce docroot mais Apache ne voit pas `miapo.app-edufrem.com` dans
  # %{HTTP_HOST} (front applicatif devant LWS). La redirection qui fonctionne
  # réellement est APPLICATIVE (src/main.js). On garde la règle, inerte, au cas
  # où l'hôte remonterait ; ne pas la « corriger » à l'aveugle : ce fichier est
  # partagé par mapo, mapoplus, adminmapo et tous les sous-domaines écoles.
  RewriteCond %{HTTP_HOST} ^miapo\.app-edufrem\.com$ [NC]
  RewriteRule ^(.*)$ https://mapoplus.app-edufrem.com/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
