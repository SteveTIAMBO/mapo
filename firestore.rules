rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// Règles de sécurité Firestore — MAPO (multi-établissements)
// ═══════════════════════════════════════════════════════════════════
//
// Principe : toutes les données d'une école vivent sous schools/{schoolId}/.
// Un utilisateur ne peut accéder qu'aux données de SON école, selon SON rôle.
//
// Déploiement : Firebase Console → Firestore → Règles, ou
//   firebase deploy --only firestore:rules
//
// ── ÉTAT MESURÉ EN CONSOLE LE 23/08/2026 ─────────────────────────
//
// Cet en-tête a longtemps affirmé que la base `mapo-edufrem` était PARTAGÉE
// avec un autre produit, et qu'un copier-coller « écraserait leurs règles ».
// C'était FAUX — Steve l'avait corrigé le 05/08 — et la phrase, restée ici, a
// servi deux fois à refuser un travail légitime.
//
// Comparaison bloc par bloc avec la production (empreinte par bloc) :
//   • 25 des 28 blocs `match` étaient IDENTIQUES au caractère près ;
//   • 3 écarts cosmétiques, à sens constant : ordre de `estMonProfil` et
//     `scolariteInchangee` dans `/b2c/`, `/users/` qui n'en diffère que par
//     imbrication, et `/mapoplus_users/` dont la prod inlinait les aides ;
//   • la prod portait EN PLUS un `match /users/{userId}/{sub}/{docId=**}`,
//     doublon exact de la règle imbriquée `/{sub}/{docId=**}` — inerte.
//
// Donc : ce fichier EST déployable. Comparer avant de publier reste une bonne
// habitude, ce n'est plus un interdit.
//
// ⚠️ Piège de mesure : l'éditeur de la console (CodeMirror) insère des
// caractères de largeur nulle (U+200B) sur les lignes vides. Ni `\s` en JS ni
// en Python ne les voit : sans les retirer, la comparaison invente des écarts.
//
// ── Section MOBI : SUPPRIMÉE le 23/08/2026, sur confirmation de Steve ──
//
// Les collections MOBI (admins, students, testimonials, articles, events,
// requests, community_posts, cf_dates) et le pont `paiements_scolarite`
// n'existent PAS dans cette base. Mesuré : les données s'y réduisent à
// `ligues`, `mapoplus_users`, `quizBank`, `superAdmins`, `users` — même
// `schools` est absent, aucune école n'étant encore déployée — et le projet ne
// déclare qu'UNE application. Ces règles ne gardaient rien ; elles ouvraient
// seulement un droit d'écriture pour le jour où quelque chose créerait ces
// collections.
//
// ── Historique des publications chirurgicales ────────────────────
//
// 05/08/2026 — `scolariteInchangee()` : un compte enfant ne peut plus modifier
//   sa scolarité. ⚠️ Non vérifié depuis une vraie session enfant.
// 05/08/2026 — `profilB2CValide()` + `allow create` sur users/{uid}, vérifié
//   par une écriture réelle depuis un compte MAPO+ (HTTP 200 là où c'était 403).
// 18/07/2026 — `/b2c/{docId}`, `/enfantsComptes/...`, `/enfantInvites/{code}`.
//   Vérifiés dans le bac à sable : get b2c/enfant_ea-A AUTORISÉ,
//   get b2c/enfant_ea-B (le frère) REFUSÉ. Le refus du `list` n'a pas pu être
//   simulé (le bac à sable n'offre que get/create/update/delete) : il est
//   déduit de la règle, pas mesuré.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Banque d'exercices partagée (tuteur MIAPO) ───────────────────
    // Contenu pédagogique non sensible (QCM de révision). Lecture/écriture
    // pour tout utilisateur authentifié → réutilisation des exercices déjà
    // générés (économie de tokens) + fonctionne hors-ligne via le cache.
    // PUBLIÉE en prod le 2026-06-19.
    match /quizBank/{key} {
      allow read, write: if request.auth != null;
    }

    // ── Ligues hebdomadaires (classement à l'effort) ─────────────────
    //
    // Une ligue par (semaine ISO, niveau de classe). Chaque participant écrit
    // UNIQUEMENT sa propre entrée, et lit toute la ligue pour voir le classement.
    //
    // ⚠️ CE QUI EST EXPOSÉ, ET POURQUOI SI PEU. Ce sont des MINEURS : l'entrée
    // ne porte QUE le prénom et un total de points. Jamais de nom de famille,
    // d'école, de pays, d'âge, ni de résultats. Un classement ne doit pas
    // devenir un annuaire d'enfants.
    //
    // ⚠️ Les points sont calculés CÔTÉ CLIENT à ce stade : un utilisateur
    // averti peut donc gonfler son score. Assumé pour le lancement (cohortes de
    // proches, enjeu nul). À déplacer côté serveur avant toute récompense qui
    // a une valeur monétaire — un bon d'achat truqué, c'est une autre affaire.
    match /ligues/{ligueId}/membres/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        // Garde-fou grossier contre le score absurde : même en révisant tous
        // les jours, on ne dépasse pas cet ordre de grandeur en une semaine.
        && request.resource.data.points <= 100000
        && request.resource.data.prenom is string
        && request.resource.data.prenom.size() <= 40
        // La liste des champs est FERMÉE : on n'accepte rien d'autre, pour que
        // personne ne glisse une donnée personnelle dans un document public.
        && request.resource.data.keys().hasOnly(['points', 'prenom', 'maj']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Diplômes vérifiables (registre public) ───────────────────────
    // Lecture PUBLIQUE par code → vérification d'authenticité SANS compte
    // (page /verifier, depuis n'importe quel appareil). Émission/révocation
    // réservées à l'émetteur, identifié par schoolUid == son uid. Jamais de
    // suppression : on révoque (passage du statut à 'revoque' via update).
    match /diplomas/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.schoolUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.schoolUid == request.auth.uid
        && request.resource.data.schoolUid == resource.data.schoolUid;
      allow delete: if false;
    }

    // ── Helpers ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Profil de l'utilisateur connecté
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // L'utilisateur appartient à cette école et son compte est actif
    function isMember(schoolId) {
      return hasProfile()
        && userDoc().schoolId == schoolId
        && userDoc().status == 'active';
    }

    // L'utilisateur a l'un des rôles indiqués dans cette école
    function hasRole(schoolId, roles) {
      return isMember(schoolId) && (userDoc().role in roles);
    }

    function isAdmin(schoolId) {
      // 'directeur' = admin en édition secondaire.
      // 'admin' = admin générique (utilisé en édition supérieur et accepté en secondaire).
      return hasRole(schoolId, ['directeur', 'admin']);
    }

    // Membre de l'équipe EDUFREM (super admin). Présence d'un document
    // dans superAdmins/{uid}. Cette collection n'est pas modifiable depuis
    // l'application — elle est gérée uniquement via la console Firebase.
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // Droit d'écriture sur une sous-collection donnée, selon le rôle.
    // Les administrateurs (directeur/admin) écrivent partout ; les autres
    // rôles sont limités à leur périmètre métier.
    //
    // Conventions de nommage des sous-collections :
    //   - secondaire : eleves, classes, notes, presences, devoirs, discipline, ...
    //   - superieur  : etudiants, programmes, promotions, intervenants, ue, edt,
    //                  inscriptions_peda, notes_sup, stages, salles,
    //                  programme_responsables,
    //                  finance_tarifs, finance_bourses, finance_comptes,
    //                  finance_echeances, finance_paiements, finance_financements,
    //                  finance_relances, finance_alloc_bourses,
    //                  mobilite_dossiers.
    function canWrite(schoolId, coll) {
      // ⚠️ `redevances` est EXCLUE d'ici et traitée par son propre bloc, plus
      // bas. Les règles Firestore s'additionnent : laisser la collection dans
      // cette fonction rendrait le bloc dédié inopérant, et un directeur
      // pourrait réécrire le montant qu'il nous doit.
      return coll != 'redevances' && isMember(schoolId) && (
        userDoc().role in ['directeur', 'admin']
        // ── Rôles secondaire ──
        || (userDoc().role == 'secretaire'
            && coll in ['eleves', 'classes', 'inscriptions', 'import', 'matieres'])
        || (userDoc().role in ['enseignant', 'surveillant']
            && coll in ['notes', 'presences', 'devoirs', 'devoirs-data', 'discipline', 'emploi-du-temps'])
        || (userDoc().role == 'comptable'
            && coll in ['facturation',
                        // Finance superieur :
                        'finance_tarifs', 'finance_bourses', 'finance_comptes',
                        'finance_echeances', 'finance_paiements', 'finance_financements',
                        'finance_relances', 'finance_alloc_bourses',
                        // Mobilite entrante (champs école côté facturation) :
                        'mobilite_dossiers'])
        || (userDoc().role == 'cantine'
            && coll in ['facturation'])
        // ── Rôles superieur ──
        || (userDoc().role == 'relation_internationale'
            && coll in ['etudiants', 'inscriptions_peda', 'mobilite_dossiers'])
        || (userDoc().role == 'responsable_formation'
            && coll in ['programmes', 'promotions', 'ue', 'intervenants', 'edt',
                        'notes_sup', 'stages', 'programme_responsables',
                        'mobilite_dossiers'])
        // L'étudiant n'écrit pas dans les sous-collections de l'école : ses propres
        // données (choix d'électives, etc.) seront gérées via des appels contrôlés
        // côté app. Lecture restreinte côté app (cf §4 du doc).
        // ── Collections partagées : tout le personnel peut écrire ──
        || coll in ['messages', 'activity']
      );
    }

    // ── Vitrines des écoles (site public one-page) ───────────────────
    // Produit « Vitrine écoles » (dossier 09_APPLICATIONS/VITRINE_ECOLES).
    // Lecture PUBLIQUE : le site vitrine est ouvert à tous (parents, moteurs).
    // Écriture réservée à la direction de l'école (directeur/admin) ou à un
    // super admin EDUFREM. schoolId = même slug que le sous-domaine MAPO de
    // l'école, donc isAdmin(schoolId) autorise le directeur sur SA vitrine.
    // Circuit de validation : le directeur (directeur/admin de SON école) rédige
    // en 'brouillon' puis 'en_attente' ; il ne peut PAS s'auto-valider. Seul un
    // super admin EDUFREM peut passer une fiche à 'valide' (mise en ligne).
    // Lecture publique uniquement si 'valide' ; sinon réservée à la direction/EDUFREM.
    match /vitrines/{schoolId} {
      allow read: if isSuperAdmin() || isAdmin(schoolId)
        || (resource != null && resource.data.get('statut', '') == 'valide');
      allow create: if (isAdmin(schoolId) || isSuperAdmin())
        && request.resource.data.get('statut', 'brouillon') in ['brouillon', 'en_attente'];
      allow update: if isSuperAdmin()
        || (isAdmin(schoolId) && request.resource.data.get('statut', 'brouillon') in ['brouillon', 'en_attente']);
      allow delete: if isSuperAdmin();
    }

    // ── Profils utilisateurs ─────────────────────────────────────────
    // Lecture : soi-même, ou les administrateurs de la même école.
    // Création : à la première connexion, validée par une invitation.
    // Mise à jour : soi-même SANS toucher schoolId/role, ou un admin
    //   de la même école (gestion des accès). Jamais de suppression.

    match /users/{uid} {

      function invitationOk() {
        return exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == request.auth.token.email
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.schoolId == request.resource.data.schoolId
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role;
      }

      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || (hasProfile()
            && userDoc().schoolId == resource.data.schoolId
            && userDoc().role in ['directeur', 'admin'])
        || isSuperAdmin()
      );

      // Compte MAPO+ (B2C) : personne ne l'invite, il s'inscrit seul. Il crée
      // donc son profil sans invitation — mais SANS pouvoir se rattacher à une
      // école ni se donner un rôle de personnel.
      //
      // ⚠️ Sans cette règle, l'inscription MAPO+ était REFUSÉE en silence :
      // `permission-denied` capté et journalisé en warning côté client (vu en
      // prod le 05/08 à la création du compte). Conséquence visible : le prénom
      // et le nom saisis à l'inscription n'étaient jamais enregistrés, et il
      // fallait les ressaisir dans les Paramètres — le reproche exact de Steve.
      function profilB2CValide() {
        return request.resource.data.b2c == true
          && request.resource.data.schoolId == null
          && request.resource.data.role in ['parent', 'apprenant'];
      }

      // L'utilisateur crée son propre profil : soit un profil B2C autonome,
      // soit un profil d'école rattaché à une invitation valide pour son email.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && (profilB2CValide() || invitationOk());

      // Soi-même : peut modifier ses infos, mais pas son école ni son rôle.
      // Admin de la même école : peut modifier rôle et statut du personnel.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid)
        || (hasProfile()
            && userDoc().schoolId == resource.data.schoolId
            && userDoc().role in ['directeur', 'admin']
            && request.resource.data.schoolId == resource.data.schoolId)
      );

      // Suppression d'un profil utilisateur : super admin EDUFREM uniquement
      // (utilisé par la suppression en cascade d'une école).
      allow delete: if isSuperAdmin();

      // Sous-collections privées de l'utilisateur (B2C autonome : progression
      // du tuteur `revisions`, données `b2c`/enfants). Accès réservé au
      // propriétaire du compte. PUBLIÉE en prod (reconstituée ici 2026-06-19 ;
      // à vérifier au besoin contre la console).
      match /{sub}/{docId=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Co-parent (MAPO+ B2C) : accès partagé aux données `b2c` au propriétaire
      // OU à un co-parent disposant d'un lien valide.
      //
      // La sous-collection `b2c` contient : `enfant_<id>` (un document PAR
      // enfant — c'est ce qui permettra à l'enfant de lire SON profil sans voir
      // sa fratrie), `enfants` (ancien document groupé, conservé en repli) et
      // `link` (pointeur du co-parent vers son parent propriétaire).
      //
      // LECTURE au niveau de la collection : indispensable, l'appli LISTE `b2c`
      // pour retrouver les enfants. Une règle par nom de document ne suffirait
      // pas — sur un `list`, Firestore exige que TOUS les documents renvoyés
      // soient autorisés, sinon la requête entière échoue.
      //
      // ÉCRITURE volontairement plus étroite : un co-parent modifie les enfants,
      // jamais `link`. Sans cette distinction il pourrait réécrire le pointeur
      // du propriétaire et détourner l'espace qu'il consulte. Une écriture porte
      // toujours sur UN document nommé, donc y filtrer par docId est sûr.
      //
      // COMPTE ENFANT : l'enfant n'a droit QU'À son document `enfant_<son id>`.
      // La portée vient du document de rattachement `enfantsComptes/{son uid}`,
      // écrit par lui-même contre un code d'invitation valide.
      // Conséquence assumée : l'enfant ne peut PAS lister `b2c` (sa fratrie ferait
      // échouer la requête) — son appli lit son document en direct.
      // ── Révisions : une famille, un espace ──────────────────────────
      // Les révisions d'un enfant vivent dans l'espace de son PARENT, au même
      // endroit que son profil — sinon le même enfant se retrouve avec deux
      // historiques selon l'appareil utilisé, et le module Progression du parent
      // ne voit jamais le travail fait depuis le compte de l'enfant.
      // L'enfant doit donc pouvoir écrire chez son parent, mais UNIQUEMENT les
      // trois documents qui portent son propre identifiant.
      match /revisions/{docId} {
        function monEnfantId() {
          return get(/databases/$(database)/documents/users/$(uid)/enfantsComptes/$(request.auth.uid)).data.enfantId;
        }
        function estMaRevision() {
          return exists(/databases/$(database)/documents/users/$(uid)/enfantsComptes/$(request.auth.uid))
            && (docId == monEnfantId()
                || docId == 'history_' + monEnfantId()
                || docId == 'conversations_' + monEnfantId()
                // Récompenses (badges, série de jours). Elles ne vivaient que
                // dans le localStorage de l'appareil : ce que l'enfant gagnait
                // sur son téléphone n'existait nulle part ailleurs, son parent
                // ne le voyait jamais, et un changement d'appareil effaçait
                // tout. Même espace que ses révisions : une famille, un espace.
                || docId == 'recompenses_' + monEnfantId()
                // Épreuves sans assistance (référentiel, écart E10). C'est la
                // seule mesure d'apprentissage réel de MIAPO, et l'apprenant la
                // passe souvent depuis SON compte : sans cette ligne, son
                // résultat ne quitterait jamais son téléphone, et un cache vidé
                // effacerait la mesure. Agrégats uniquement, jamais de question
                // ni de réponse.
                || docId == 'epreuves_' + monEnfantId());
        }
        allow read, write: if isSignedIn() && (request.auth.uid == uid || estMaRevision());
      }

      match /b2c/{docId} {
        function isCoParent() {
          return exists(/databases/$(database)/documents/users/$(uid)/coParents/$(request.auth.uid));
        }
        function estMonProfil() {
          return exists(/databases/$(database)/documents/users/$(uid)/enfantsComptes/$(request.auth.uid))
            && docId == 'enfant_' + get(/databases/$(database)/documents/users/$(uid)/enfantsComptes/$(request.auth.uid)).data.enfantId;
        }
        // La SCOLARITÉ n'appartient pas à l'enfant : elle est du ressort de son
        // parent. Un enfant qui se déclarerait en Terminale changerait ce que le
        // tuteur lui propose et fausserait le suivi que voit sa mère.
        //
        // ⚠️ Liste de ce qui est GELÉ, et non liste de ce qui est permis. Le
        // document `enfant_<id>` ne contient pas qu'un profil : il porte aussi
        // ses notes, son planning, ses révisions, son questionnaire 6C et ses
        // centres d'intérêt — tout ce que l'enfant alimente légitimement en
        // travaillant. Une liste blanche aurait bloqué ses révisions en croyant
        // protéger son niveau.
        function scolariteInchangee() {
          return !request.resource.data.enfant.diff(resource.data.enfant).affectedKeys().hasAny([
            'id', 'createdAt',
            'cycle', 'niveau', 'pays', 'ecole', 'ecoleReliee', 'matricule', 'lienEcole', 'filiere',
            'formation', 'formationUrl', 'formationModules', 'formationModulesDetail',
            'formationPlan', 'formationPlanAt',
            'objectifNote', 'objectifs', 'bareme',
            'catEcole', 'catFormation', 'certifId', 'organisme', 'certifDate',
          ]);
        }
        allow read: if isSignedIn() && (request.auth.uid == uid || isCoParent() || estMonProfil());
        allow write: if isSignedIn() && (
          request.auth.uid == uid
          || ((docId == 'enfants' || docId.matches('enfant_.*')) && isCoParent())
          // `resource != null` : l'enfant modifie un profil que son parent a
          // créé, il n'en crée jamais. Sur une création, `resource.data`
          // n'existe pas et la comparaison n'aurait aucun sens.
          || (estMonProfil() && resource != null && scolariteInchangee())
        );
      }

      // Comptes enfants : le propriétaire gère ; l'enfant crée SON rattachement
      // uniquement avec un code valide, et l'invitation doit désigner CE parent
      // ET l'enfant que le rattachement prétend viser (sans quoi il pourrait
      // pointer le profil d'un frère ou d'une sœur).
      match /enfantsComptes/{enfantUid} {
        allow read, delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == enfantUid);
        allow create: if isSignedIn()
          && request.auth.uid == enfantUid
          && request.resource.data.enfantUid == enfantUid
          && exists(/databases/$(database)/documents/enfantInvites/$(request.resource.data.code))
          && get(/databases/$(database)/documents/enfantInvites/$(request.resource.data.code)).data.ownerUid == uid
          && get(/databases/$(database)/documents/enfantInvites/$(request.resource.data.code)).data.enfantId == request.resource.data.enfantId;
        // Jamais de mise à jour : changer `enfantId` après coup rouvrirait la
        // porte au profil d'un autre enfant. On retire et on refait.
        allow update: if false;
      }

      // Liens co-parents : le propriétaire gère ; le co-parent crée SON lien
      // uniquement avec un code d'invitation valide, et peut le retirer.
      match /coParents/{coParentUid} {
        allow read, delete: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == coParentUid);
        allow create: if isSignedIn()
          && request.auth.uid == coParentUid
          && request.resource.data.coParentUid == coParentUid
          && exists(/databases/$(database)/documents/coParentInvites/$(request.resource.data.code))
          && get(/databases/$(database)/documents/coParentInvites/$(request.resource.data.code)).data.ownerUid == uid;
      }
    }

    // ── Invitations co-parent (MAPO+ B2C) ────────────────────────────
    // Un code d'invitation rattache un 2e parent à l'espace du 1er.
    // Lecture : tout compte connecté (pour redeem) ; création/suppression : le propriétaire.
    match /coParentInvites/{code} {
      // `get` et NON `read` : `read` autoriserait le LISTING de tous les codes
      // (énumération → n'importe qui se rattacherait à n'importe quelle famille).
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Invitations compte enfant (MAPO+ B2C) ────────────────────────
    // Un code rattache UN enfant précis (ownerUid + enfantId) à son propre
    // compte. Même précaution que les codes co-parent : `get` et NON `read`,
    // sinon n'importe qui listerait tous les codes et se rattacherait à
    // n'importe quel enfant.
    match /enfantInvites/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Invitations ──────────────────────────────────────────────────
    // Une invitation rattache un email à une école + un rôle.
    // Lecture : le destinataire (par son email) ou un admin de l'école.
    // Création/gestion : les administrateurs de l'école concernée.
    // Le destinataire peut seulement passer le statut à 'accepted'.

    match /invitations/{invId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.email
        || isAdmin(resource.data.schoolId)
        || isSuperAdmin()
      );

      allow create: if isAdmin(request.resource.data.schoolId) || isSuperAdmin();

      allow update: if isSignedIn() && (
        isAdmin(resource.data.schoolId)
        || isSuperAdmin()
        || (request.auth.token.email == resource.data.email
            && request.resource.data.email == resource.data.email
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == 'accepted')
      );

      allow delete: if isAdmin(resource.data.schoolId) || isSuperAdmin();
    }

    // ── Établissements et leurs données ──────────────────────────────
    // Le document école : lisible par ses membres, modifiable par ses
    // administrateurs. Création hors application (provisioning EDUFREM
    // via la console / le SDK admin).

    match /schools/{schoolId} {
      // Lecture publique du document école (nom, sigle, edition, logoUrl,
      // modulesActifs, configSup). Permet aux pages publiques (login, ID
      // visuelle) d'afficher le branding AVANT authentification. Les
      // sous-collections (étudiants, finance, etc.) restent privées via
      // les règles du `match /{coll}/{docId=**}` plus bas.
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isAdmin(schoolId) || isSuperAdmin();
      // Suppression d'école réservée à EDUFREM (bouton « Supprimer l'école »).
      allow delete: if isSuperAdmin();

      // Toutes les sous-collections de modules (eleves, classes, notes,
      // presences, devoirs, discipline, facturation, inscriptions,
      // emploi-du-temps, messages, activity, matieres, personnel, ...).
      // Lecture : tout le personnel de l'école + les super admins EDUFREM.
      // Écriture : selon le rôle (les super admins ne modifient pas les
      // données métier d'une école, sauf à se créer une invitation s'ils
      // veulent y entrer comme membre).
      match /{coll}/{docId=**} {
        allow read: if isMember(schoolId) || isSuperAdmin();
        allow write: if canWrite(schoolId, coll);
      }

      // ── Redevance EDUFREM ────────────────────────────────────────
      //
      // Ce que l'école nous doit. Elle naît au moment où l'inscription est
      // validée — soit, pour Steve, au premier paiement de la famille, en
      // général les frais d'inscription. Pas d'inscription : pas d'élève dans
      // l'outil, pas d'accès MAPO+, et donc pas de commission.
      //
      // ⚠️ L'école CRÉE la ligne (c'est son acte qui la déclenche) et peut la
      // marquer versée, mais elle ne peut PAS en changer le montant, ni la
      // supprimer. Sans ce verrou, le client fixait lui-même la somme qu'il
      // nous doit — ce n'est pas une hypothèse de malveillance, c'est
      // simplement une facture qu'on ne laisse pas éditer par le débiteur.
      //
      // Le montant est figé à l'écriture : l'application ne réécrit jamais une
      // redevance existante, elle la relit.
      match /redevances/{ligne} {
        allow read: if isMember(schoolId) || isSuperAdmin();
        allow create: if isSuperAdmin() || (isMember(schoolId)
          && userDoc().role in ['directeur', 'admin', 'secretaire', 'comptable']);
        allow update: if isSuperAdmin() || (isMember(schoolId)
          && userDoc().role in ['directeur', 'admin', 'comptable']
          && request.resource.data.montant == resource.data.montant
          && request.resource.data.base == resource.data.base
          && request.resource.data.taux == resource.data.taux
          && request.resource.data.eleveId == resource.data.eleveId
          && request.resource.data.annee == resource.data.annee);
        // Effacer une dette n'est pas une opération d'école.
        allow delete: if isSuperAdmin();
      }
    }

    // ── Barème de redevance EDUFREM, par PAYS ────────────────────────
    //
    // Taux de commission et coordonnées de versement (RIB, Orange Money) que
    // l'équipe EDUFREM tient pour chaque pays. Décision de Steve du 28/08/2026 :
    // par PAYS, pas par école.
    //
    // Lecture ouverte à tout compte connecté : une école doit pouvoir lire le
    // taux qu'on lui applique et savoir OÙ verser. Écriture réservée à EDUFREM —
    // c'est notre barème, une école ne fixe pas la commission qu'elle nous doit.
    match /edufrem/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Super admins EDUFREM ─────────────────────────────────────────
    // La présence d'un document dans cette collection désigne un membre
    // de l'équipe EDUFREM. Géré exclusivement via la console Firebase
    // (jamais d'écriture depuis l'application).
    match /superAdmins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // ── Section MOBI : RETIRÉE le 23/08/2026 ─────────────────────────
    //
    // Un jeu de règles complet vivait ici (admins, students, testimonials,
    // articles, events, requests + messages, community_posts, cf_dates), plus
    // le pont `paiements_scolarite` MOBI ↔ MAPO. Il datait d'une migration
    // annoncée « pour partager Firestore », qui n'a jamais eu lieu.
    //
    // Mesuré en console le 23/08/2026 : AUCUNE de ces collections n'existe
    // dans `mapo-edufrem`. Les données s'y réduisent à ligues, mapoplus_users,
    // quizBank, superAdmins et users, et le projet ne déclare qu'une seule
    // application. Ces règles ne gardaient donc rien — elles autorisaient
    // seulement des écritures le jour où quelque chose créerait ces
    // collections. Une règle qui ne protège aucune donnée n'est pas neutre :
    // c'est une porte ouverte qu'on a cessé de surveiller.
    //
    // Suppression confirmée par Steve. Le pont `paiements_scolarite` part avec
    // elles : il dépendait des aides `isMobi*`, et sa collection est vide.
    // Si le workflow de paiement de scolarité revient, il faudra le réécrire
    // avec les rôles MAPO — pas ressusciter celui-ci.

    // ── Utilisateurs MAPO+ (B2C standalone) ──────────────────────────
    // Base des inscrits MAPO+ (mapoplus.app-edufrem.com) : chaque personne gère
    // SON propre enregistrement ; le super-admin EDUFREM peut tout lister
    // (onglet MAPO+ du méga-admin). Collection isolée, ne touche pas à MOBI.
    match /mapoplus_users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    // ── Tout le reste est refusé par défaut ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
